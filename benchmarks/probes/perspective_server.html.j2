<!doctype html><meta charset=utf-8>
<link rel="stylesheet" href="./dist/viewer/dist/css/themes.css">
<style>body{margin:0}perspective-viewer{width:900px;height:400px}</style>
<perspective-viewer id="v"></perspective-viewer>
<script src="./contract.js"></script>
<script type="module">
import { perspective } from './dist/perspective.js';
const H = window.__benchHelpers;
// See the wasm probe: viewer-charts renders head(2,000,000 / view columns) rows.
const MAX_CELLS = 2000000, VIEW_COLUMNS = 2;
try {
  const t0 = performance.now();
  // For a DISK source the server holds only the file path; this GET makes it read the
  // file + build the server Table INSIDE the timed window — that is INGESTION, which is
  // what perspective provides for a file. For an IN-MEMORY source the Table was already
  // built in preload() (resident), so /build returns immediately. Either way it answers
  // with the row count, so the render cap can be reported without a second round trip.
  const built = await fetch("{{BUILD_URL}}");
  const rows = Number(built.headers.get('X-Rows'));
  // Without a row count the cap fraction would silently compute as 1.0 ("drew it all"),
  // which is the one thing this number exists to disprove. Fail the trial instead.
  if (!rows) throw new Error(`/build gave no X-Rows: ${built.headers.get('X-Rows')}`);
  const client = await perspective.websocket("{{WS_URL}}");   // server-held table (virtual)
  const viewer = document.getElementById('v');
  await viewer.load(client);
  await viewer.restore({ plugin: 'X/Y Line', table: 'bench', columns: ['x', 'y1'] });
  await viewer.flush();
  // Total only: the build/stream/render stages overlap over one websocket, so no
  // component is separable — a null is reported as null, never back-derived.
  H.benchDone(t0, { rendered_fraction: Math.min(1, Math.floor(MAX_CELLS / VIEW_COLUMNS) / rows) });
} catch (e) { H.benchError(e); }
</script>
