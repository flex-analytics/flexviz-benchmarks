<!doctype html><meta charset=utf-8>
<link rel="stylesheet" href="./dist/viewer/dist/css/themes.css">
<style>body{margin:0}perspective-viewer{width:900px;height:400px}</style>
<perspective-viewer id="v"></perspective-viewer>
<script src="./contract.js"></script>
<script type="module">
import { perspective } from './dist/perspective.js';
const H = window.__benchHelpers;
// viewer-charts caps every chart at 2,000,000 CELLS and renders head(cap / view columns)
// rows — leading-prefix truncation, not downsampling, and there is no public setter.
// X/Y Line assigns exactly two columns (x, y1), so the ceiling is 1,000,000 rows.
const MAX_CELLS = 2000000, VIEW_COLUMNS = 2;
try {
  // --- Phase 1: build the native in-browser WASM Table (NOT timed). ---
  let buf = await (await fetch('./bench.arrow')).arrayBuffer();
  const client = await perspective.worker();
  const table = await client.table(buf, { name: 'bench' });   // WASM Table = the resident store
  buf = null;
  const rows = await table.size();
  const rendered_fraction = Math.min(1, Math.floor(MAX_CELLS / VIEW_COLUMNS) / rows);
  await new Promise((resolve) => setTimeout(resolve, 0));
  await H.benchStored();                            // signal store built; block until harness samples + releases
  // --- Phase 2: timed render (store already resident). Native X/Y Line over the raw
  // x/y columns: nothing authored — no group_by, no expressions, no sort. ---
  const viewer = document.getElementById('v');
  const t0 = performance.now();
  await viewer.load(client);
  await viewer.restore({ plugin: 'X/Y Line', table: 'bench', columns: ['x', 'y1'] });
  await viewer.flush();
  H.benchDone(t0, { rendered_fraction });           // total only: in-browser engine, no transfer phase
} catch (e) { H.benchError(e); }
</script>
