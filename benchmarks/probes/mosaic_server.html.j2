<!doctype html><meta charset=utf-8><style>body{margin:0}#chart{width:900px;height:400px}</style>
<div id="chart"></div>
<script src="./contract.js"></script>
<script type="module">
import * as vg from "./dist/mosaic_server_vgplot.js";  // vgplot bundled w/o wasm (socket only)
const H = window.__benchHelpers;
const CHART = {{CHART_TYPE}}, N_TRACES = {{N_TRACES}}, K = {{BINS_OR_NPTS}};  // K = bins or n_points
function mark(t) {
  const color = `hsl(${t*36},70%,55%)`;
  if (CHART === "histogram")
    return vg.rectY(vg.from("bench"), { x: vg.bin(`value${t+1}`, {steps:K}), y: vg.count(), fill: color, fillOpacity: 0.6 });
  if (CHART === "line")
    return vg.lineY(vg.from("bench"), { x: "x", y: `y${t+1}`, stroke: color });
  // hist2d: width/height force the raster grid to K x K (binDimensions is otherwise
  // pixel-driven); fill:"density" is vgplot's own count-per-cell channel; bandwidth stays
  // at its 0 default, so the grid is the counts, unsmoothed.
  if (CHART === "hist2d")
    return vg.raster(vg.from("bench"), { x: "value1", y: "value2", fill: "density", width: K, height: K });
  throw new Error("unknown chart " + CHART);
}
try {
  vg.coordinator().databaseConnector(vg.socketConnector({ uri: "{{WS_URL}}" }));  // 0.30: options object, not a URI string
  const marks = [];
  for (let t = 0; t < N_TRACES; t++) marks.push(mark(t));
  const t0 = performance.now();
  const plot = vg.plot(...marks, vg.width(900), vg.height(400));
  document.getElementById("chart").replaceChildren(plot);
  await plot.value.update();
  H.benchDone(t0);                              // total only: vgplot exposes no server/transfer/client split
} catch (e) { H.benchError(e); }
</script>
